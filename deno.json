{
  "name": "@catniplabs/box",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Enterprise-oriented, serverless-first REST API framework for Deno and Web Standard runtimes.",
  "repository": "https://github.com/CatnipLabs/Box",
  "homepage": "https://github.com/CatnipLabs/Box#readme",
  "bugs": "https://github.com/CatnipLabs/Box/issues",
  "exports": {
    ".": "./src/mod.ts",
    "./core": "./src/core/index.ts",
    "./http": "./src/presentation/http/index.ts",
    "./logger": "./src/logger/index.ts",
    "./orm": "./src/infra/persistence/kv/index.ts",
    "./adapters/deno": "./src/infra/runtime/deno.ts"
  },
  "tasks": {
    "dev": "deno test --allow-read=src --watch tests",
    "test": "deno test --allow-read=src tests",
    "test:unit": "deno test --allow-read=src tests/unit",
    "test:integration": "deno test --allow-read=src tests/integration",
    "test:performance": "deno test --allow-read=src tests/performance",
    "coverage": "rm -rf coverage && deno test --allow-read=src --coverage=coverage tests && deno run --allow-run scripts/check_coverage.ts coverage 90 85 85",
    "coverage:report": "deno coverage --exclude=tests/ coverage",
    "check": "deno check src examples bench scripts tests",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "bench": "deno bench"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/testing": "jsr:@std/testing@^1.0.18",
    "zod": "npm:zod@^3.25.76",
    "zod-to-json-schema": "npm:zod-to-json-schema@^3.25.2"
  }
}
